{
  "name": "jarvis-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test main/core.test.ts",
    "jarvis": "node main/cli.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron-vite preview",
    "postinstall": "electron-rebuild -f -w node-pty",
    "install-app": "electron-vite build && bash scripts/install-app.sh"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "gsap": "^3.15.1",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "main": "out/main/index.js",
  "productName": "Jarvis",
  "description": "Your personal voice assistant"
}
